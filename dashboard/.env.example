DATA_SOURCE=sqlite
DATABASE_PATH=../data/uml.sqlite
# Optional when the database contains more than one Discord guild.
DASHBOARD_GUILD_ID=
DASHBOARD_AUTH_REQUIRED=false
DASHBOARD_DISCORD_CLIENT_ID=
DASHBOARD_DISCORD_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side URL for the Bun bot health endpoint. Never expose this as NEXT_PUBLIC_.
BOT_HEALTH_URL=http://127.0.0.1:8080/health
