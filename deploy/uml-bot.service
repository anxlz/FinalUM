[Unit]
Description=UM League CODM Scrim Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=umlbot
Group=umlbot
WorkingDirectory=/opt/uml-bot
EnvironmentFile=/opt/uml-bot/.env
ExecStart=/home/umlbot/.bun/bin/bun run src/main.ts

Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=uml-bot

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uml-bot/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=768M

[Install]
WantedBy=multi-user.target
